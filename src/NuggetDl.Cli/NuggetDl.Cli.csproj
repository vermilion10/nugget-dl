<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NuggetDl.Core\NuggetDl.Core.csproj" />
    <ProjectReference Include="..\NuggetDl.UnityInterop\NuggetDl.UnityInterop.csproj" />
    <ProjectReference Include="..\NuggetDl.CriInterop\NuggetDl.CriInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\cri_worker\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cri_worker\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
